      posthog.init('phc_sXJQxMYrqtBVCX5wLKGLmvJwBtMMdWoSzfscVUWHkx5d', {
        api_host: 'https://t.autoclaw.sh',
        ui_host: 'https://eu.posthog.com',
        defaults: '2026-01-30',
        person_profiles: 'identified_only',
      });
    </script>
  </head>
  <body>
    <main class="landingMain">
      <header class="landingTopbar">
        <a href="/" class="landingBrand">
          <span class="brandMark"></span>
          AutoClaw
        </a>

        <button type="button" class="landingMenuButton" aria-label="Toggle navigation menu" aria-expanded="false" id="menuBtn">
          <span></span><span></span><span></span>
        </button>

        <nav class="landingNavLinks" id="navLinks">
          <a href="/playbooks" class="landingNavLink">Playbooks</a>
          <a href="/examples" class="landingNavLink">Examples</a>
          <a href="/blog" class="landingNavLink">Blog</a>
          <a href="/tools" class="landingNavLink">Tools</a>
          <a href={GITHUB_URL} class="landingNavLink" target="_blank" rel="noopener" style="color:var(--ink-faint)">GitHub ↗</a>
          <a href={SCOPE_URL} class="landingNavCta">Scope a deployment</a>
        </nav>
      </header>

      <slot />

      <footer class="landingFooter">
        <div>
          <a href="/" class="footerBrand"><span class="brandMark"></span> AutoClaw</a>
          <p class="footerTag">The open deployment reference for OpenClaw agents. Made by <a href="https://www.datopian.com" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Datopian</a>.</p>
        </div>
        <div class="footerCols">
          <div class="footerCol">
            <span class="footerColHead">RESOURCES</span>
            <a href="/playbooks">Playbooks</a>
            <a href="/examples">Examples</a>
            <a href="/blog">Blog</a>
          </div>
          <div class="footerCol">
            <span class="footerColHead">COMPANY</span>
            <a href="/forward-deployed">Forward Deployed</a>
            <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
      </footer>
    </main>

    <script>
      const btn = document.getElementById('menuBtn');
      const nav = document.getElementById('navLinks');
      btn?.addEventListener('click', () => {
        const open = btn.classList.toggle('isOpen');
        nav?.classList.toggle('isOpen', open);
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
